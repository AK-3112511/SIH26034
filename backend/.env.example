# MetrologyAI backend configuration.  Copy to .env and adjust.
# Every key is optional; the defaults boot a local development server.

ENV=development                      # development | production (production refuses the dev JWT secret)

# --- Authentication -------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database (PostgreSQL 15/16 + PostGIS) --------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=metrologyai
# Or a full URL instead of the five values above:
# SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgrespassword@localhost:5432/metrologyai

# --- Evidence storage -----------------------------------------------------
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_DIR=uploads
# S3_BUCKET_NAME=
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=                   # e.g. MinIO / Cloudflare R2
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
FILE_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=15728640

# --- Vision engines -------------------------------------------------------
OCR_ENGINE=paddle                    # paddle (real, needs requirements-ai.txt) | mock (tests only)
SEMANTIC_ENGINE=rules                # rules | florence2 (needs torch + transformers)
DETECTOR_ENGINE=auto                 # auto | yolov8 | geometric
PIPELINE_MAX_CONCURRENCY=2

# --- Dashboard origins ----------------------------------------------------
# localhost on any port is always allowed in development.
CORS_ORIGINS=
