# MetrologyAI Backend Configuration

# API Service
PROJECT_NAME="MetrologyAI API Service"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 15 + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=metrologyai

# Optional direct URL override (defaults to postgresql://<user>:<password>@<server>:<port>/<db>)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/metrologyai
